{
  "name": "dudesphere",
  "version": "0.0.1",
  "private": true,
  "description": "The Dudesphere: a NestJS API and a Next.js web app in one pnpm workspace.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "dev": "pnpm build:packages && pnpm -r --parallel run dev",
    "dev:api": "pnpm --filter \"@dudesphere/api^...\" run build && pnpm --filter @dudesphere/api run dev",
    "dev:web": "pnpm --filter \"@dudesphere/web^...\" run build && pnpm --filter @dudesphere/web run dev",
    "build:packages": "pnpm -r --filter \"./packages/**\" run build",
    "build": "pnpm -r run build",
    "typecheck": "pnpm build:packages && pnpm -r run typecheck",
    "test": "pnpm build:packages && pnpm -r run test",
    "test:e2e": "pnpm --filter @dudesphere/api run test:e2e",
    "e2e:cleanup": "pnpm --filter @dudesphere/api run e2e:cleanup",
    "e2e:check": "pnpm --filter @dudesphere/api run e2e:check",
    "lint": "oxlint --type-aware",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "db:up": "docker compose --env-file apps/api/.env up -d",
    "db:down": "docker compose --env-file apps/api/.env down"
  },
  "devDependencies": {
    "@northguild/gmt-oxlint": "^1.2.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": "^26"
  },
  "packageManager": "pnpm@12.8.1",
  "cspell": {
    "words": [
      "dudesphere",
      "abiding",
      "abidings",
      "northguild"
    ]
  }
}
