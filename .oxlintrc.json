{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": ["@northguild/gmt-oxlint"],
  "extends": ["./node_modules/@northguild/gmt-oxlint/config/recommended.json"],
  "plugins": ["import"],
  "rules": {
    "typescript/no-explicit-any": "off",
    "typescript/no-floating-promises": "error"
  },
  "env": {
    "node": true
  },
  "overrides": [
    {
      "files": ["src/**/*.entity.ts", "src/**/*.schema.ts"],
      "rules": {
        "@northguild/gmt-oxlint/no-date-global": "off",
        "@northguild/gmt-oxlint/no-new-date": "off"
      }
    }
  ]
}
