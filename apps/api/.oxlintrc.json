{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["../../.oxlintrc.json"],
  "plugins": [],
  "overrides": [
    {
      "files": ["src/**/*.entity.ts", "src/**/*.schema.ts"],
      "rules": {
        "@northguild/gmt-oxlint/no-date-global": "off",
        "@northguild/gmt-oxlint/no-new-date": "off"
      }
    },
    {
      "files": ["src/shared/**/*.ts"],
      "rules": {
        "@northguild/gmt-oxlint/no-date-global": "off",
        "@northguild/gmt-oxlint/no-new-date": "off"
      }
    }
  ]
}
