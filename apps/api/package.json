{
  "name": "@dudesphere/api",
  "version": "0.0.1",
  "private": true,
  "description": "",
  "license": "UNLICENSED",
  "author": "",
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "start": "nest start --env-file .env ",
    "dev": "nest start --env-file .env --watch",
    "start:dev": "nest start --env-file .env --watch",
    "start:debug": "nest start --env-file .env --debug --watch",
    "start:prod": "node dist/main",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "migration:generate": "typeorm-ts-node-esm migration:generate -d src/database/data-source.ts",
    "migration:run": "typeorm-ts-node-esm migration:run -d src/database/data-source.ts",
    "migration:revert": "typeorm-ts-node-esm migration:revert -d src/database/data-source.ts",
    "migration:check": "typeorm-ts-node-esm migration:generate -d src/database/data-source.ts --check src/database/migrations/Check",
    "seed:run": "tsx src/database/seeds/run-seeds.ts",
    "backfill:hashtags": "tsx src/database/seeds/backfill-hashtags.ts",
    "dev:token": "tsx src/dev/print-token.ts"
  },
  "dependencies": {
    "@nestjs/authentication": "0.1.1",
    "@nestjs/authorization": "0.1.0",
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.1.3",
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/observe": "^0.3.0",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.1",
    "@northguild/gmt": "^1.18.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "mongoose": "^9.10.2",
    "nodemailer": "^10.0.16",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@dudesphere/api-types": "workspace:*",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.1.3",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^26.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "dotenv": "^18.0.4",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": "^26"
  }
}
