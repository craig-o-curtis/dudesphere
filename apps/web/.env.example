# Copy to .env.local. Next reads it on start. Never commit .env.local.

# Where the NestJS API listens. Server-side only: no NEXT_PUBLIC_ prefix, so
# the browser never learns it. The browser talks only to this app.
API_URL=http://localhost:3000

# Lets Nest count rate limits by each visitor's IP address, not this app's.
# Use the same value as BFF_SECRET in apps/api/.env: at least 32 characters,
# all letters, digits or + / = _ -. A value that breaks that rule is never
# sent.
# Server-side only: never give it a NEXT_PUBLIC_ prefix, or the browser gets
# it. Leave it empty in dev to skip it. Nest then counts this app's address.
BFF_SECRET=
