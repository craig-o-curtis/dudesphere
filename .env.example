# development, staging, production or test. Default: development
NODE_ENV=development

# The port the app listens on. Default: 3000
PORT=3000

# https://www.observe.nestjs.com/dashboard/projects/dude-42593
DUDE_OBSERVE_APP_KEY=''
DUDE_OBSERVE_APP_SECRET=''

# Auth: the key that signs login tokens. At least 32 characters, or the app
# will not start. Make one with: openssl rand -base64 48
JWT_SECRET=''
# How long a login token lasts, in seconds. Default: 3600
JWT_EXPIRES_IN=3600
# Written into every token and checked on every request.
# Defaults: dudesphere-api and dudesphere
JWT_AUDIENCE=dudesphere-api
JWT_ISSUER=dudesphere

# Rate limiting: true or false. Default: true. Leave it on.
THROTTLE_ENABLED=true

# Seeded admin login. Used by `pnpm seed:run` and the e2e tests.
EMAIL=''
PASSWORD=''

# Postgres
PG_ADMIN_USER=''
PG_ADMIN_PW=''
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=''

## MongoDB
# Default: mongodb://localhost:27017/dude-abidings
MONGO_URI=''
MG_ADMIN_USER=''
MG_ADMIN_PW=''

# Mail
# Outgoing email, over SMTP. The defaults send to the Mailpit container from
# docker-compose.yml, which shows every email at http://localhost:8025 and
# delivers none. Defaults: localhost and 1025
MAIL_HOST=localhost
MAIL_PORT=1025
# The SMTP login. Mailpit needs none, so leave both empty for local work.
MAIL_USER=''
MAIL_PASSWORD=''
# Who every email is from. Default: Dudesphere <no-reply@dudesphere.local>
MAIL_FROM=''
# Where the web app is served. The password reset email links to it.
# Default: http://localhost:3000
FRONTEND_URL=''
# How long a password reset link works, in seconds. Default: 1800
PASSWORD_RESET_EXPIRES_IN=1800